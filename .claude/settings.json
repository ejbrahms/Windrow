{
  "permissions": {
    "allow": [
      "mcp__wispfield__*",
      "Bash(netstat -ano:*)",
      "Bash(npm start)",
      "Bash(npm run dev)",
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch",
      "TaskList",
      "TaskGet",
      "TaskOutput",
      "mcp__claude-design__list_projects",
      "mcp__claude-design__get_project",
      "mcp__claude-design__list_files",
      "mcp__claude-design__read_file",
      "mcp__claude-design__list_comments",
      "mcp__claude-design__list_members",
      "mcp__claude-design__list_design_systems",
      "mcp__claude-design__get_conversation",
      "mcp__claude_ai_Gmail__get_message",
      "mcp__claude_ai_Gmail__get_thread",
      "mcp__claude_ai_Gmail__list_drafts",
      "mcp__claude_ai_Gmail__list_labels",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Google_Drive__get_file_metadata",
      "mcp__claude_ai_Google_Drive__get_file_permissions",
      "mcp__claude_ai_Google_Drive__list_recent_files",
      "mcp__claude_ai_Google_Drive__read_file_content",
      "mcp__claude_ai_Google_Drive__search_files",
      "mcp__claude_ai_Google_Drive__download_file_content",
      "mcp__governance__list_capabilities",
      "mcp__governance__list_principals",
      "mcp__governance__whoami",
      "mcp__governance__list_grants",
      "mcp__governance__who_can_use",
      "mcp__governance__get_usage",
      "mcp__governance__get_usage_summary",
      "mcp__governance__get_drift",
      "mcp__governance__get_fleet_summary"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/server/hooks/pre-tool-use.js\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/server/hooks/post-tool-use.js\"" }
        ]
      }
    ]
  }
}
