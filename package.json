{
  "name": "windrow",
  "private": true,
  "version": "1.0.0",
  "description": "Capability governance: one service \u2014 backend API + built frontend served together, so they start, stop, and stay up as a single unit instead of two things that can drift apart.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "setup": "node scripts/setup.js",
    "setup:show": "node scripts/setup.js --show",
    "verify:topology": "node scripts/verify-topology.js",
    "build": "node scripts/build-client.js",
    "start": "node scripts/start.js",
    "upgrade:begin": "node scripts/upgrade.js begin",
    "upgrade:status": "node scripts/upgrade.js status",
    "upgrade:end": "node scripts/upgrade.js end",
    "denials:off": "node scripts/enforcement.js off",
    "denials:on": "node scripts/enforcement.js on",
    "denials:status": "node scripts/enforcement.js status",
    "start:server": "node server/supervisor.js",
    "start:backend": "node server/index.js",
    "restart": "node scripts/restart.js",
    "restart:status": "node scripts/restart.js status",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "sandbox": "node scripts/sandbox.js",
    "sandbox:keep": "node scripts/sandbox.js --keep",
    "sandbox:env": "node scripts/sandbox.js --env",
    "oobe:dev": "node scripts/oobe.js dev",
    "oobe:resume": "node scripts/oobe.js resume",
    "oobe:reset": "node scripts/oobe.js reset",
    "service:install": "node scripts/service-install.js",
    "service:uninstall": "node scripts/service-uninstall.js",
    "central": "npm run central --prefix server",
    "central:db": "docker compose -f server/central/docker-compose.yml up -d",
    "central:db:stop": "docker compose -f server/central/docker-compose.yml down",
    "seed": "npm run seed --prefix server",
    "seed:central": "node server/seed-central.js",
    "enroll": "node scripts/enroll.js",
    "smoke:central": "npm run smoke:central --prefix server",
    "shadow:compare": "npm run shadow:compare --prefix server",
    "central:install": "node scripts/central-install.js",
    "central:uninstall": "node scripts/central-install.js --uninstall"
  },
  "devDependencies": {
    "node-windows": "^1.0.0-beta.8"
  }
}
