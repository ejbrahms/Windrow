node_modules/
dist/
build/
.env
.env.local
*.log
.DS_Store
wispfield-files/

# Throwaway sandbox for `npm run oobe:*` (scripts/oobe.js) — regenerated by `oobe:reset`, never
# meant to be shared or committed.
.oobe-sandbox/

# Throwaway alternate-port instance for `npm run sandbox` (scripts/sandbox.js) — holds a COPY of
# the live governance.db, so it carries real data and must never be committed. Re-made on each
# `npm run sandbox`.
.sandbox/

# node-windows service install artifacts (scripts/service-install.js / server/daemon/windrow.xml
# reference) — generated per-machine by `npm run service:install`, and windrow.xml in particular
# bakes in the installing machine's real username, hostname, and absolute repo path. Never commit
# these; anyone installing the service gets their own copy regenerated locally.
server/daemon/*.exe
server/daemon/*.exe.config
server/daemon/*.xml
# The same, for the central host's service (scripts/central-install.js writes
# server/central/daemon/windrowcentral.xml, which bakes in this machine's hostname, home directory,
# absolute repo path AND the Postgres DSN — password included).
server/central/daemon/*.exe
server/central/daemon/*.exe.config
server/central/daemon/*.xml

# Internal security reviews and audits. These enumerate the broker's attack surface and the
# host's own filesystem layout, so they stay local — the architecture docs under docs/design/
# that README links are the public ones.
docs/design/governance-vulnerability-review.md
docs/design/governance-review-*.md
docs/design/secrets-audit-*.md

# `npm run setup` writes this: what THIS host is (central URL, database URL, ports, credential
# paths). Host-specific by definition, and WINDROW_CENTRAL_DB_URL carries a Postgres password —
# committing it would put one machine's fleet configuration, and that password, in every checkout.
windrow.env

# Backups taken during a cutover or migration. windrow.env and server/daemon/*.xml are already
# ignored, but a copy of one under another name is not — and those files carry the Postgres DSN,
# password included. Ignore the whole class rather than each incident.
*.bak-*
*.bak

# TypeScript incremental build state. A build artifact, regenerated by `tsc -b` on every build and
# holding absolute paths from whichever machine ran it — so it churns in every diff and conflicts
# between contributors, while telling a reader nothing. Tracked by accident until now.
*.tsbuildinfo

# local demo DB credentials — never commit
.env.demo

.vercel
.env*
