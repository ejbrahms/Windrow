# Build context is the repo root (see server/central/Dockerfile), so this keeps the node's own
# state and every node_modules tree out of the image.

.git
**/node_modules

# The node's live state — its SQLite registry, its CA, its credentials. None of it belongs in an
# image, and server/data is a volume in the container anyway.
server/data
server/daemon
server/central/daemon
server/*.log
server/**/*.log

# The client. Its SOURCE and toolchain stay out — the image builds no frontend, it copies a bundle
# somebody already built (see the COPY in server/central/Dockerfile for why there is no second
# builder stage). But `client/dist` has to come IN, because since
# docs/design/dashboard-placement.md item 4 central is the ONLY thing that serves the dashboard:
# the node's static mount is gone. This line used to read "central serves no UI", which was true
# when it was written and is now exactly backwards.
client
!client/dist
!client/dist/**

# Local config that would otherwise be baked in.
windrow.env
.env
*.env.local

docs
wispfield-files
