# windrow.env.example — a template, not a live config.
#
# DO NOT edit this file to configure a host. Run `npm run setup` instead: it asks what this
# machine is (a standalone node, a node in a fleet, the central host, or both for development),
# probes the database, builds the dashboard, enrolls against central, and writes a real
# `windrow.env` for you. Every step is idempotent, so you can re-run it any time.
#
# This file exists to show which variables a windrow.env holds and what a value looks like.
# Every value below is a PLACEHOLDER — copying them verbatim configures nothing real. In
# particular the Postgres password here is a stand-in; `npm run setup` generates a strong random
# one and writes it for you.
#
# server/config.js reads windrow.env at startup, and a real environment variable ALWAYS wins over
# a line in it — so `WINDROW_CENTRAL_URL=… npm start` and the Windows service's explicit config
# are never overridden by this file. Delete a line to leave that variable unset.
#
#   npm run setup                 interactive — asks what this machine is
#   npm run setup -- --show       print how this machine is configured, change nothing
#   npm run setup -- --dry-run    print what it would do, change nothing

# --- Node: what a hook talks to -----------------------------------------------------------------
# The supervisor holds the public port; the API runs as a child process behind it.
PORT=4000
WINDROW_UPSTREAM_PORT=4100
WINDROW_TLS_PORT=4443
WINDROW_DB_PATH=/path/to/server/data/windrow.db
# Your home directory, where ~/.claude and ~/.gemini live. The Windows service runs as
# LocalSystem, whose home is not the one hooks need — so it is captured explicitly.
WINDROW_USER_HOME=/home/you

# --- Joining a fleet ----------------------------------------------------------------------------
# Central's base URL as THIS node reaches it. Use the https mutual-TLS port; the plaintext
# listener is loopback-only.
WINDROW_CENTRAL_URL=https://central.example:5443
# shadow — usage goes up, this node keeps its own policy authority.
# authority — central owns capabilities and grants, this node reads a replica.
WINDROW_FLEET_MODE=shadow
# Set to `central` only in authority mode; unset (delete the line) in shadow mode or standalone.
WINDROW_POLICY_AUTHORITY=central
# Where this node's enrollment credential lives, and the name it is issued under. The shipper and
# the policy client both load `node-shipper` — enrolling under another name looks fine and sends
# nothing.
WINDROW_CREDENTIAL_DIR=/path/to/server/data/credentials
WINDROW_SHIP_CREDENTIAL_NAME=node-shipper
# Assigned by central at enrollment.
WINDROW_NODE_ID=node-xxxxxxxx

# --- Central host -------------------------------------------------------------------------------
# The fleet's Postgres. `npm run setup` generates a strong random password; this one is a
# placeholder. The password is why windrow.env itself is git-ignored.
WINDROW_CENTRAL_DB_URL=postgres://windrow:CHANGE_ME@localhost:5432/windrow_central
# Mutual-TLS port nodes connect to.
WINDROW_CENTRAL_TLS_PORT=5443
# Loopback plaintext listener, development only. Delete both lines to keep it off.
WINDROW_CENTRAL_ALLOW_INSECURE=1
WINDROW_CENTRAL_PORT=5000
# Hostnames and IPs nodes reach this host by, comma-separated — these go into central's server
# certificate.
WINDROW_SERVER_SANS=central.example,10.0.0.1
# The fleet's certificate authority. On a central host this directory holds the fleet's private
# key — keep it on this host only.
WINDROW_CA_DIR=/path/to/server/data/ca
