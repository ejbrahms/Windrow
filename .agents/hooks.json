{
  "capability-governance": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node server/hooks/agy-pre-tool-use.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node server/hooks/agy-post-tool-use.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
